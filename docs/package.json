{
	"name": "docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm build:content && vite dev",
		"build": "pnpm -w build:packages && pnpm build:content && wrangler types && vite build && pagefind --site .svelte-kit/cloudflare",
		"build:content": "velite",
		"build:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm build:content && pnpm build:paraglide && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.24.1",
		"@levish0/lily-pad": "workspace:*",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.3.0",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"pagefind": "^1.5.2",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"velite": "^0.4.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0",
		"wrangler": "^4.125.0"
	}
}
